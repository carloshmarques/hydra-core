# Auto detect text files and perform LF normalization
* text=auto

# C# / .NET source files (Windows standard CRLF or normalized)
*.cs     text diff=csharp
*.csproj text
*.sln    text eol=crlf

# Web, Docs & Configs (Unix LF standard)
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.cfg    text eol=lf
*.svg    text eol=lf
*.py     text eol=lf

# Shell & Windows Scripts
*.sh     text eol=lf
*.ps1    text eol=crlf
*.bat    text eol=crlf

# Binary files (do not modify line endings)
*.png    binary
*.jpg    binary
*.ico    binary
*.dll    binary
*.exe    binary
